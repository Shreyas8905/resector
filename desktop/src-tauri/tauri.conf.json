{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReSector",
  "version": "0.1.4",
  "identifier": "com.resector.app",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ReSector",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/backend": "backend",
      "../build/frontend": "frontend"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzOTE4NTQxNEM4QTREQUQKUldTdFRZcE1RWVdSUTBBaXlCOHdiMEpFOEJpdWVobVdOZ3hZWFBDSmZrSEIvZWo3cThRNi9lakwK",
      "endpoints": [
        "https://github.com/Shreyas8905/resector/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

FROM python:3.11-slim

# Install system dependencies in one layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    gnupg2 \
    lsb-release \
    sudo \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/postgresql-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql-keyring.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-15 \
        nodejs \
        supervisor \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first (layer caching)
COPY backend/requirements.txt ./backend/
RUN pip install --no-cache-dir -r backend/requirements.txt

# Install Node dependencies (layer caching)
COPY frontend/package*.json ./frontend/
RUN cd frontend && npm install --production=false

# Copy application code
COPY backend/ ./backend/
COPY frontend/ ./frontend/

# Build frontend
RUN cd frontend && npm run build

# Create data and log directories
RUN mkdir -p /app/data/chroma /app/uploads /var/log/supervisor

# Set up PostgreSQL data directory and initialize the cluster
RUN mkdir -p /app/data/postgres \
    && chown -R postgres:postgres /app/data/postgres \
    && sudo -u postgres /usr/lib/postgresql/15/bin/initdb -D /app/data/postgres \
    && sudo -u postgres /usr/lib/postgresql/15/bin/pg_ctl -D /app/data/postgres start \
    && sudo -u postgres psql -c "CREATE USER resector WITH PASSWORD 'resector';" \
    && sudo -u postgres psql -c "CREATE DATABASE resector OWNER resector;" \
    && sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE resector TO resector;" \
    && sudo -u postgres /usr/lib/postgresql/15/bin/pg_ctl -D /app/data/postgres stop

# Copy startup script and supervisor configuration
COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

EXPOSE 3000 8000

CMD ["/app/start.sh"]

FROM python:3.11-slim

# Install system dependencies in one layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    gnupg2 \
    lsb-release \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/postgresql-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql-keyring.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-15 \
        nodejs \
        npm \
        supervisor \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first (layer caching)
COPY backend/requirements.txt ./backend/
RUN pip install --no-cache-dir -r backend/requirements.txt

# Install Node dependencies (layer caching)
COPY frontend/package*.json ./frontend/
RUN cd frontend && npm install

# Copy application code
COPY backend/ ./backend/
COPY frontend/ ./frontend/

# Build frontend
RUN cd frontend && npm run build

# Initialize PostgreSQL cluster and create database/user
RUN service postgresql start \
    && su - postgres -c "psql -c \"CREATE USER resector WITH PASSWORD 'resector';\"" \
    && su - postgres -c "psql -c \"CREATE DATABASE resector OWNER resector;\"" \
    && su - postgres -c "psql -c \"GRANT ALL PRIVILEGES ON DATABASE resector TO resector;\"" \
    && service postgresql stop

# Copy supervisor configuration
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Create data directories
RUN mkdir -p /app/data/chroma /app/uploads /var/log/supervisor

EXPOSE 3000 8000

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
